# NIRUX boot splash, made by nirusplash @VERSION@ for a @W@x@H@ screen.
#
# The banner is typed one # at a time (the newest one white, the rest in the
# accent), then A MINIMAL X11 DESKTOP, then the block cursor blinks: the
# same as nirulock's ascii layout. A disk password is asked at a prompt in
# the same style. Everything is drawn from pictures made for this screen;
# a screen of another size scales them. Shutting down or restarting shows
# the banner at once and two status lines, the cursor blinking after them.

Window.SetBackgroundTopColor(@BG_R@, @BG_G@, @BG_B@);
Window.SetBackgroundBottomColor(@BG_R@, @BG_G@, @BG_B@);

# Timing, in milliseconds (nirulock's values).
global.type_banner = 28;
global.breath = 500;
global.type_line = 70;
global.blink = 530;
# Plymouth calls the refresh function 50 times a second.
global.frame_ms = 20;

global.n = @N@;
@HASH_SET@

global.img.hash = Image("hash.png");
global.img.hot = Image("hash-hot.png");
global.img.hcur = Image("hash-cursor.png");
global.img.scan = Image("scan.png");
for (i = 0; i < @TAG_LEN@; i++) {
  if (i < 10) global.img.tagc[i] = Image("tag-0" + i + ".png");
  else global.img.tagc[i] = Image("tag-" + i + ".png");
}
global.img.cur = Image("cursor.png");
global.img.curhot = Image("cursor-hot.png");
global.img.prompt = Image("prompt.png");
global.img.bullet = Image("bullet.png");
global.img.working = Image("working.png");
global.img.fail = Image("fail.png");
global.img.bclosed = Image("bye-closed.png");
global.img.boff = Image("bye-off.png");
global.img.breboot = Image("bye-reboot.png");

global.t = 0;
global.typed = 0;
global.shown_line = 0;
global.sw = 0;
global.sh = 0;
global.ask = 0;
global.bullets = 0;
global.status = "";
# Shutting down: 0 not yet, else the time it began; the mode it shows.
global.bye = 0;
global.bye_mode = "";

for (i = 0; i < global.n; i++) {
  global.hs[i] = Sprite();
  global.hs[i].SetOpacity(0);
  global.hs[i].SetZ(10);
}
global.s.hcur = Sprite();
global.s.hcur.SetZ(15);
global.s.scan = Sprite();
global.s.scan.SetZ(20);
global.s.scan.SetOpacity(@SCAN@);
for (i = 0; i < @TAG_LEN@; i++) {
  global.ts[i] = Sprite();
  global.ts[i].SetZ(25);
  global.ts[i].SetOpacity(0);
}
global.s.cur = Sprite();
global.s.cur.SetZ(40);
global.s.cur.SetOpacity(0);
global.s.prompt = Sprite();
global.s.prompt.SetZ(40);
global.s.prompt.SetOpacity(0);
global.s.pcur = Sprite();
global.s.pcur.SetZ(40);
global.s.pcur.SetOpacity(0);
global.s.status = Sprite();
global.s.status.SetZ(40);
global.s.status.SetOpacity(0);
global.s.b1 = Sprite();
global.s.b1.SetZ(40);
global.s.b1.SetOpacity(0);
global.s.b2 = Sprite();
global.s.b2.SetZ(40);
global.s.b2.SetOpacity(0);
for (i = 0; i < 32; i++) {
  global.bs[i] = Sprite();
  global.bs[i].SetZ(40);
  global.bs[i].SetOpacity(0);
}

fun scaled(image) {
  if (global.k == 1) return image;
  w = Math.Int(image.GetWidth() * global.k + 0.5);
  h = Math.Int(image.GetHeight() * global.k + 0.5);
  if (w < 1) w = 1;
  if (h < 1) h = 1;
  return image.Scale(w, h);
}

fun px(v) {
  return Math.Int(v * global.k + 0.5);
}

# Place everything for the screen Plymouth has now. Called again when the
# screen changes (the firmware's picture hands over to the real driver).
fun layout() {
  global.sw = Window.GetWidth();
  global.sh = Window.GetHeight();
  global.ox = Window.GetX();
  global.oy = Window.GetY();
  global.k = 1;
  if (global.sw != @W@) global.k = global.sw / @W@;
  if (global.sh * @W@ < global.sw * @H@) {
    kh = global.sh / @H@;
    if (kh < global.k) global.k = kh;
  }
  global.si.hash = scaled(global.img.hash);
  global.si.hot = scaled(global.img.hot);
  global.si.hcur = scaled(global.img.hcur);
  global.si.cur = scaled(global.img.cur);
  global.si.curhot = scaled(global.img.curhot);
  global.si.bullet = scaled(global.img.bullet);
  global.si.working = scaled(global.img.working);
  global.si.fail = scaled(global.img.fail);
  centre = global.ox + global.sw / 2;
  top = global.oy + global.sh * 46 / 100 - px(@H@ * 46 / 100 - @TOP@);
  global.adv = px(@ADV@);
  global.row = px(@ROW@);
  global.left = Math.Int(centre - px(@BANNER_W@) / 2);
  global.top = Math.Int(top);
  for (i = 0; i < global.n; i++) {
    global.hs[i].SetX(global.left + global.hc[i] * global.adv);
    global.hs[i].SetY(global.top + global.hr[i] * global.row);
    if (i < global.typed) global.hs[i].SetImage(global.si.hash);
  }
  global.s.scan.SetImage(scaled(global.img.scan));
  global.s.scan.SetX(global.left);
  global.s.scan.SetY(global.top);
  global.tag_adv = px(@TAG_ADV@);
  global.tag_left = Math.Int(centre - px(@TAG_W@) / 2);
  global.tag_y = global.top + px(@BANNER_H@) + px(@GAP@);
  for (i = 0; i < @TAG_LEN@; i++) {
    global.ts[i].SetImage(scaled(global.img.tagc[i]));
    global.ts[i].SetX(global.tag_left + i * global.tag_adv);
    global.ts[i].SetY(global.tag_y);
  }
  global.p_y = global.tag_y + px(@TAG_H@) + px(@U@ * 5 / 2);
  global.p_left = Math.Int(centre - (px(@PROMPT_W@) + 12 * global.tag_adv) / 2);
  global.s.prompt.SetImage(scaled(global.img.prompt));
  global.s.prompt.SetX(global.p_left);
  global.s.prompt.SetY(global.p_y);
  for (i = 0; i < 32; i++) {
    global.bs[i].SetImage(global.si.bullet);
    global.bs[i].SetX(global.p_left + px(@PROMPT_W@) + i * global.tag_adv);
    global.bs[i].SetY(global.p_y);
  }
  global.s.pcur.SetImage(global.si.cur);
  global.s.pcur.SetY(global.p_y);
  global.s.status.SetX(global.p_left);
  global.b_left = Math.Int(centre - px(@BYE_W@) / 2);
  global.s.b1.SetImage(scaled(global.img.bclosed));
  global.s.b1.SetX(global.b_left);
  global.s.b1.SetY(global.p_y);
  global.s.b2.SetX(global.b_left);
  global.s.b2.SetY(global.p_y + px(@U@) * 3 / 2);
  show_bye();
  show_status();
}

fun is_bye(mode) {
  return mode == "shutdown" || mode == "reboot";
}

fun show_bye() {
  if (global.bye_mode == "reboot") global.s.b2.SetImage(scaled(global.img.breboot));
  else global.s.b2.SetImage(scaled(global.img.boff));
}

fun show_status() {
  # Under the prompt while it asks, in its place once the answer is in.
  if (global.ask) global.s.status.SetY(global.p_y + px(@U@) * 3 / 2);
  else global.s.status.SetY(global.p_y);
  if (global.status == "working") {
    global.s.status.SetImage(global.si.working);
    global.s.status.SetOpacity(1);
  } else if (global.status == "fail") {
    global.s.status.SetImage(global.si.fail);
    global.s.status.SetOpacity(1);
  } else {
    global.s.status.SetOpacity(0);
  }
}

fun blink_on() {
  return Math.Int(global.t / global.blink) % 2 == 0;
}

fun refresh() {
  global.t += global.frame_ms;
  if (Window.GetWidth() != global.sw || Window.GetHeight() != global.sh) layout();

  # Shutting down or restarting (the mode can change on the way: Void asks
  # for a restart after the daemon has started).
  mode = Plymouth.GetMode();
  if (is_bye(mode)) {
    if (global.bye == 0) {
      # The banner and the line at once: there is no time to type them.
      global.t = global.n * global.type_banner + global.breath + @TAG_LEN@ * global.type_line;
      global.bye = global.t;
    }
    if (mode != global.bye_mode) {
      global.bye_mode = mode;
      show_bye();
    }
  }

  # The banner.
  want = Math.Int(global.t / global.type_banner);
  if (want > global.n) want = global.n;
  if (want > global.typed) {
    if (global.typed > 0) global.hs[global.typed - 1].SetImage(global.si.hash);
    for (i = global.typed; i < want; i++) {
      if (i == want - 1 && want < global.n) global.hs[i].SetImage(global.si.hot);
      else global.hs[i].SetImage(global.si.hash);
      global.hs[i].SetOpacity(1);
    }
    global.typed = want;
  }
  if (global.typed < global.n) {
    if (global.typed == 0) { r = 0; c = 0; }
    else { r = global.hr[global.typed - 1]; c = global.hc[global.typed - 1] + 1; }
    global.s.hcur.SetImage(global.si.hcur);
    global.s.hcur.SetX(global.left + c * global.adv);
    global.s.hcur.SetY(global.top + r * global.row);
    global.s.hcur.SetOpacity(1);
  } else {
    global.s.hcur.SetOpacity(0);
  }

  # The line under it, then the cursor.
  start = global.n * global.type_banner + global.breath;
  line = 0;
  if (global.t >= start) line = Math.Int((global.t - start) / global.type_line) + 1;
  if (line > @TAG_LEN@) line = @TAG_LEN@;
  for (i = global.shown_line; i < line; i++) global.ts[i].SetOpacity(1);
  if (line > global.shown_line) global.shown_line = line;
  done = global.t >= start + @TAG_LEN@ * global.type_line;
  if (global.bye) {
    since = global.t - global.bye;
    if (since >= 150) global.s.b1.SetOpacity(1);
    if (since >= 450) global.s.b2.SetOpacity(1);
    if (global.bye_mode == "reboot") w = px(@BYE_REBOOT_W@);
    else w = px(@BYE_OFF_W@);
    global.s.cur.SetImage(global.si.cur);
    if (since < 450) {
      global.s.cur.SetOpacity(0);
    } else {
      global.s.cur.SetX(global.b_left + w + global.tag_adv);
      global.s.cur.SetY(global.p_y + px(@U@) * 3 / 2);
      if (blink_on()) global.s.cur.SetOpacity(1);
      else global.s.cur.SetOpacity(0);
    }
  } else if (global.typed < global.n) {
    global.s.cur.SetOpacity(0);
  } else if (!done) {
    global.s.cur.SetImage(global.si.curhot);
    global.s.cur.SetX(global.tag_left + line * global.tag_adv);
    global.s.cur.SetY(global.tag_y);
    global.s.cur.SetOpacity(1);
  } else {
    global.s.cur.SetImage(global.si.cur);
    global.s.cur.SetX(global.tag_left + (@TAG_LEN@ + 1) * global.tag_adv);
    global.s.cur.SetY(global.tag_y);
    if (global.ask) global.s.cur.SetOpacity(0);
    else if (blink_on()) global.s.cur.SetOpacity(1);
    else global.s.cur.SetOpacity(0);
  }

  # The password prompt's own cursor.
  if (global.ask) {
    shown = global.bullets;
    if (shown > 32) shown = 32;
    global.s.pcur.SetX(global.p_left + px(@PROMPT_W@) + shown * global.tag_adv);
    if (blink_on()) global.s.pcur.SetOpacity(1);
    else global.s.pcur.SetOpacity(0);
  } else {
    global.s.pcur.SetOpacity(0);
  }
}
Plymouth.SetRefreshFunction(refresh);

fun show_bullets(count) {
  global.bullets = count;
  for (i = 0; i < 32; i++) {
    if (i < count) global.bs[i].SetOpacity(1);
    else global.bs[i].SetOpacity(0);
  }
}

fun password(prompt, count) {
  # Asked again after an answer: the answer was wrong.
  if (global.status == "working") global.status = "fail";
  else if (count > 0 && global.status == "fail") global.status = "";
  global.ask = 1;
  global.s.prompt.SetOpacity(1);
  show_bullets(count);
  show_status();
}
Plymouth.SetDisplayPasswordFunction(password);

fun question(prompt, entry) {
  global.ask = 1;
  global.s.prompt.SetOpacity(1);
  show_bullets(0);
}
Plymouth.SetDisplayQuestionFunction(question);

fun normal() {
  if (global.ask) global.status = "working";
  global.ask = 0;
  global.s.prompt.SetOpacity(0);
  show_bullets(0);
  show_status();
}
Plymouth.SetDisplayNormalFunction(normal);

layout();
